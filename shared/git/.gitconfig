[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Fix for Homebrew git ownership issues on macOS
# This can happen when Homebrew directory has mixed ownership (e.g., root/user)
# or when migrating from another user account. Safe to leave even if not needed.
[safe]
	directory = /opt/homebrew

# User identity loaded from active profile
[includeIf "gitdir:~/"]
	path = ~/.dotfiles/.gitconfig.active-profile

[pull]
	rebase = true
[branch]
	autoSetupRebase = always
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
	useForceIfIncludes = true
[rebase]
	abbreviateCommands = true
	autoSquash = true
	autoStash = true
	updateRefs = true
[init]
	defaultBranch = main
